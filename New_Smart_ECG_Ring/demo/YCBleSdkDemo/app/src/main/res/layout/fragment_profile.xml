<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D99FF"
    tools:context=".ui.fragments.ProfileFragment">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <LinearLayout
            android:id="@+id/profilePictureContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <!-- Circular Profile Image -->
            <ImageView
                android:id="@+id/ivProfileImage"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/circle_shape"
                android:scaleType="fitCenter" />

            <!-- Vertical Layout for Upload Button and Text -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Upload Button -->
                <Button
                    android:id="@+id/btnUpload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/round_button"
                    android:drawableStart="@drawable/baseline_upload_24"
                    android:elevation="5dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="Upload Photo"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />

                <!-- Allowed file formats & size info -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Allowed JPG, PNG, or GIF\nMax size: 2MB"
                    android:textColor="#000000"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/profilePictureContainer"
            android:orientation="vertical">

            <!-- First Name -->
            <LinearLayout
                android:id="@+id/etFirstNameGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="First name"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etFirstName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="name"
                    android:background="@drawable/input_box_background"
                    android:inputType="text"
                    android:padding="15dp"
                    android:layout_marginBottom="20dp"/>
            </LinearLayout>

            <!-- Last Name -->
            <LinearLayout
                android:id="@+id/etLastNameGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Last name"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etLastName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="name"
                    android:background="@drawable/input_box_background"
                    android:inputType="text"
                    android:padding="15dp"
                    android:layout_marginBottom="20dp"/>
            </LinearLayout>

            <!-- Name -->
            <LinearLayout
                android:id="@+id/etNameGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Name"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="name"
                    android:background="@drawable/input_box_background"
                    android:inputType="text"
                    android:padding="15dp"
                    android:layout_marginBottom="20dp"/>
            </LinearLayout>

            <!-- Relation -->
            <LinearLayout
                android:id="@+id/relationshipSelectorGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Relation"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>
                <RelativeLayout
                    android:id="@+id/relationshipSelector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp">
                    <Spinner
                        android:id="@+id/spinnerRelation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/input_box_background"
                        android:padding="5dp"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginTop="10dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="false"
                        android:src="@drawable/baseline_keyboard_arrow_down_24" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Email -->
            <LinearLayout
                android:id="@+id/etEmailIdGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email id"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etEmailId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="emailAddress"
                    android:background="@drawable/input_box_background"
                    android:inputType="textEmailAddress"
                    android:padding="15dp"
                    android:layout_marginBottom="20dp"/>
            </LinearLayout>

            <!-- Mobile -->
            <LinearLayout
                android:id="@+id/etPhoneNumberGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mobile number"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etPhoneNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="phone"
                    android:background="@drawable/input_box_background"
                    android:inputType="phone"
                    android:padding="15dp"
                    android:layout_marginBottom="20dp"/>
            </LinearLayout>

            <!-- Emergency Contact Number -->
            <LinearLayout
                android:id="@+id/etEmergencyContactNumberGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Emergency contact number"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etEmergencyContactNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="phone"
                    android:background="@drawable/input_box_background"
                    android:inputType="phone"
                    android:padding="15dp"
                    android:layout_marginBottom="20dp"/>
            </LinearLayout>

            <!-- DOB -->
            <LinearLayout
                android:id="@+id/etDateOfBirthGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Date of birth"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp">
                    <EditText
                        android:id="@+id/etDateOfBirth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="phone"
                        android:background="@drawable/input_box_background"
                        android:inputType="date"
                        android:padding="15dp"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivCalendar"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginTop="10dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="false"
                        android:contentDescription="Calendar Icon"
                        android:src="@drawable/baseline_calendar_month_24" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Gender -->
            <LinearLayout
                android:id="@+id/spinnerGenderGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gender"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp">
                    <Spinner
                        android:id="@+id/spinnerGender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/input_box_background"
                        android:padding="5dp"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginTop="10dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="false"
                        android:src="@drawable/baseline_keyboard_arrow_down_24" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Blood Groups -->
            <LinearLayout
                android:id="@+id/spinnerBloodGroupsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Blood group"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp">
                    <Spinner
                        android:id="@+id/spinnerBloodGroups"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/input_box_background"
                        android:padding="5dp"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginTop="10dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="false"
                        android:src="@drawable/baseline_keyboard_arrow_down_24" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Height (cm) -->
            <LinearLayout
                android:id="@+id/etHeightGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Height (cm)"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etHeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/input_box_background"
                    android:inputType="numberDecimal"
                    android:padding="15dp"
                    android:layout_marginBottom="20dp"/>
            </LinearLayout>

            <!-- Weight (kg) -->
            <LinearLayout
                android:id="@+id/etWeightGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Weight (kg)"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/input_box_background"
                    android:inputType="numberDecimal"
                    android:padding="15dp"
                    android:layout_marginBottom="20dp"/>
            </LinearLayout>

            <!-- Address -->
            <LinearLayout
                android:id="@+id/etAddressGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Address"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/input_box_background"
                    android:inputType="textPostalAddress"
                    android:padding="15dp"
                    android:layout_marginBottom="20dp"/>
            </LinearLayout>

            <!-- Country -->
            <LinearLayout
                android:id="@+id/etCountryGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Country"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etCountry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/input_box_background"
                    android:inputType="text"
                    android:padding="15dp"
                    android:layout_marginBottom="20dp"/>
            </LinearLayout>

            <!-- State -->
            <LinearLayout
                android:id="@+id/etStateGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="State"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/input_box_background"
                    android:inputType="text"
                    android:padding="15dp"
                    android:layout_marginBottom="20dp"/>
            </LinearLayout>

            <!-- City -->
            <LinearLayout
                android:id="@+id/etCityGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="City"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/input_box_background"
                    android:inputType="text"
                    android:padding="15dp"
                    android:layout_marginBottom="20dp"/>
            </LinearLayout>

            <!-- Zip Code -->
            <LinearLayout
                android:id="@+id/etZipCodeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Zip code"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etZipCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/input_box_background"
                    android:inputType="number"
                    android:padding="15dp"
                    android:layout_marginBottom="20dp"/>
            </LinearLayout>

            <!-- Existing Diseases (Multi-Select Search) -->
            <LinearLayout
                android:id="@+id/etExistingDiseasesGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Existing Diseases"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>
                <MultiAutoCompleteTextView
                    android:id="@+id/etExistingDiseases"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/input_box_background"
                    android:inputType="text"
                    android:padding="15dp"
                    android:layout_marginBottom="20dp"/>
            </LinearLayout>

            <!-- Existing Medication (Disabled) -->
            <LinearLayout
                android:id="@+id/etExistingMedicationsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Existing Medication"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etExistingMedications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/input_box_background"
                    android:inputType="text"
                    android:padding="15dp"
                    android:layout_marginBottom="30dp"/>
            </LinearLayout>

            <!-- Save Button -->
            <Button
                android:id="@+id/btnSaveProfileData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/round_button"
                android:elevation="10dp"
                android:text="Save"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="20sp" />
        </LinearLayout>

    </RelativeLayout>

</ScrollView>