<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0D99FF"
        android:padding="16dp"
        tools:context=".ui.LinkedAccountDetailsFragment">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- Linked Account Card -->
        <androidx.cardview.widget.CardView
                android:id="@+id/linked_account_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                <!-- Profile Row -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                    <ImageView
                            android:id="@+id/linked_account_profile_image"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:background="@drawable/circle_shape"
                            android:scaleType="centerCrop"
                            android:src="@drawable/apple" />

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                        <TextView
                                android:id="@+id/linked_account_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Harsha Vardhan"
                                android:textColor="@android:color/black"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                        <TextView
                                android:id="@+id/linked_account_relation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="(Friends)"
                                android:textColor="#808080"
                                android:textSize="14sp" />

                        <TextView
                                android:id="@+id/linked_account_age_gender"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="35 years old - Male"
                                android:textColor="@android:color/black"
                                android:textSize="14sp" />

                        <TextView
                                android:id="@+id/linked_account_height_weight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Height: 170 cm   Weight: 55 kg"
                                android:textColor="@android:color/black"
                                android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>



                <WebView
                        android:id="@+id/mapWebView"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="12dp"
                        android:visibility="gone" />

                <TextView
                        android:id="@+id/mapPlaceholderText"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="No location available"
                        android:textColor="#999999"
                        android:textSize="16sp"
                        android:visibility="gone" />

                <!-- Health Indicators -->
                <TextView
                        android:id="@+id/linked_account_health_indicators_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Health indicators"
                        android:textColor="@android:color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                <LinearLayout
                        android:id="@+id/linked_account_health_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                    <!-- Heart Rate -->
                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="#F6F8FA"
                            android:orientation="horizontal"
                            android:padding="12dp">

                        <TextView
                                android:id="@+id/linked_account_heart_rate_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Heart rate"
                                android:textColor="#333333"
                                android:textSize="14sp" />

                        <TextView
                                android:id="@+id/linked_account_heart_rate_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 times/min"
                                android:textColor="#333333"
                                android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Heart Rate Variability -->
                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="#F6F8FA"
                            android:orientation="horizontal"
                            android:padding="12dp">

                        <TextView
                                android:id="@+id/linked_account_hrv_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Heart rate variability"
                                android:textColor="#333333"
                                android:textSize="14sp" />

                        <TextView
                                android:id="@+id/linked_account_hrv_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 ms"
                                android:textColor="#333333"
                                android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Blood Pressure -->
                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="#F6F8FA"
                            android:orientation="horizontal"
                            android:padding="12dp">

                        <TextView
                                android:id="@+id/linked_account_bp_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Blood pressure"
                                android:textColor="#333333"
                                android:textSize="14sp" />

                        <TextView
                                android:id="@+id/linked_account_bp_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0/0 mmHg"
                                android:textColor="#333333"
                                android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Blood Oxygen -->
                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="#F6F8FA"
                            android:orientation="horizontal"
                            android:padding="12dp">

                        <TextView
                                android:id="@+id/linked_account_oxygen_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Blood oxygen"
                                android:textColor="#333333"
                                android:textSize="14sp" />

                        <TextView
                                android:id="@+id/linked_account_oxygen_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textColor="#333333"
                                android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Stress -->
                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="#F6F8FA"
                            android:orientation="horizontal"
                            android:padding="12dp">

                        <TextView
                                android:id="@+id/linked_account_stress_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Stress"
                                android:textColor="#333333"
                                android:textSize="14sp" />

                        <TextView
                                android:id="@+id/linked_account_stress_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#333333"
                                android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Temperature -->
                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="#F6F8FA"
                            android:orientation="horizontal"
                            android:padding="12dp">

                        <TextView
                                android:id="@+id/linked_account_temperature_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Temperature"
                                android:textColor="#333333"
                                android:textSize="14sp" />

                        <TextView
                                android:id="@+id/linked_account_temperature_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#333333"
                                android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Sleep Duration -->
                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="#F6F8FA"
                            android:orientation="horizontal"
                            android:padding="12dp">

                        <TextView
                                android:id="@+id/linked_account_sleep_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Sleep Duration"
                                android:textColor="#333333"
                                android:textSize="14sp" />

                        <TextView
                                android:id="@+id/linked_account_sleep_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#333333"
                                android:textSize="14sp" />
                    </LinearLayout>


                </LinearLayout>

                <!-- Sports Overview -->
                <TextView
                        android:id="@+id/linked_account_sports_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Today's Sports Overview"
                        android:textColor="@android:color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                <LinearLayout
                        android:id="@+id/linked_account_sports_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_margin="4dp"
                            android:layout_weight="1"
                            android:background="#F6F8FA"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp">

                        <TextView
                                android:id="@+id/linked_account_step_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@android:color/black"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Step count"
                                android:textColor="#888888"
                                android:textSize="14sp" />
                    </LinearLayout>


                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_margin="4dp"
                            android:layout_weight="1"
                            android:background="#F6F8FA"
                            android:backgroundTintMode="src_in"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp">

                        <TextView
                                android:id="@+id/linked_account_distance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.00"
                                android:textColor="@android:color/black"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="mile"
                                android:textColor="#888888"
                                android:textSize="14sp" />
                    </LinearLayout>


                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_margin="4dp"
                            android:layout_weight="1"
                            android:background="#F6F8FA"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp">

                        <TextView
                                android:id="@+id/linked_account_calories"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@android:color/black"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Calories"
                                android:textColor="#888888"
                                android:textSize="14sp" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Disassociation Button -->
        <Button
                android:id="@+id/btnDisassociation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/round_button"
                android:backgroundTint="#FF3B30"
                android:paddingHorizontal="36dp"
                android:text="Disassociation"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
