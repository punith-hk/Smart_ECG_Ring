<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0D99FF"
        android:padding="16dp"
        tools:context=".ui.fragments.LinkAccountFragment">

    <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="To add details, please enter the valid registered mobile number of the person."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="12dp"
            android:textAlignment="center"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


    <!-- Email Input -->
    <EditText
            android:id="@+id/etMobile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/input_box_background"
            android:hint="Enter the mobile number"
            android:inputType="phone"
            android:maxLength="10"
            android:digits="0123456789"
            android:padding="14dp"
            app:layout_constraintTop_toBottomOf="@id/tvInstruction"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- Send Code Button -->
    <Button
            android:id="@+id/btnSendCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/round_button"
            android:minWidth="120dp"
            android:padding="10dp"
            android:text="Get verification code"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/etMobile"
            app:layout_constraintStart_toStartOf="parent" />

    <!-- Resend Timer -->
    <TextView
            android:id="@+id/tvResendTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Resend in 60s"
            android:textColor="#ffffff"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/btnSendCode"
            app:layout_constraintStart_toStartOf="parent" />

    <!-- Verification Code Input -->
    <EditText
            android:id="@+id/etVerificationCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/input_box_background"
            android:hint="Please enter the verification code"
            android:inputType="number"
            android:maxLength="6"
            android:padding="14dp"
            app:layout_constraintTop_toBottomOf="@id/tvResendTimer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- Relationship Dropdown -->
    <RelativeLayout
            android:id="@+id/relationshipSelector"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/etVerificationCode"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <Spinner
                android:id="@+id/spinnerRelation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_box_background"
                android:padding="5dp" />

        <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/baseline_keyboard_arrow_down_24" />

    </RelativeLayout>

    <!-- Confirm Association Button -->
    <Button
            android:id="@+id/btnConfirmAssociation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/round_button"
            android:paddingHorizontal="36dp"
            android:paddingVertical="14dp"
            android:text="Confirm association"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/relationshipSelector"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
