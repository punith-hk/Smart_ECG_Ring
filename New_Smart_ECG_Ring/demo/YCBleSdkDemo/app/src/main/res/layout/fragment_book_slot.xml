<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#0D99FF"
    tools:context=".ui.fragments.BookSlotFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <include
                android:id="@+id/doctorCard"
                layout="@layout/item_book_new_view"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/symptoms_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:elevation="12dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="16dp"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:text="Symptoms"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/editSymptoms"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_alignParentEnd="true"
                            android:layout_marginEnd="20dp"
                            android:layout_marginTop="0dp"
                            android:src="@drawable/baseline_edit_note_24" />
                    </RelativeLayout>

                    <!-- Symptoms List Container -->
                    <LinearLayout
                        android:id="@+id/symptomsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:orientation="vertical">

                        <!-- Selected symptoms will be dynamically added here -->
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/chooseTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:text="@string/choose_your_preferred_date_time"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!--           Calendar                  -->
            <androidx.cardview.widget.CardView
                android:id="@+id/calendar_card"
                android:layout_width="match_parent"
                android:layout_height="375dp"
                android:layout_margin="12dp"
                android:elevation="12dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:background="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:weightSum="3">

                        <Button
                            android:id="@+id/btnPrevWeek"
                            android:layout_width="60dp"
                            android:layout_height="40dp"
                            android:textSize="13sp"
                            android:textAllCaps="false"
                            android:text="Prev"
                            tools:ignore="HardcodedText"
                            android:layout_weight="1"
                            android:backgroundTint="#0D99FF"
                            android:textColor="@android:color/white"/>

                        <TextView
                            android:id="@+id/tvMonthYear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:text="Jan 2025"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <Button
                            android:id="@+id/btnNextWeek"
                            android:layout_width="60dp"
                            android:layout_height="40dp"
                            android:textSize="13sp"
                            android:textAllCaps="false"
                            android:text="Next"
                            tools:ignore="HardcodedText"
                            android:layout_weight="1"
                            android:backgroundTint="#0D99FF"
                            android:textColor="@android:color/white"/>
                    </LinearLayout>

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/viewPager"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:layout_gravity="center"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="20dp"
                android:padding="8dp">

                <Button
                    android:id="@+id/makeAnAppointment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/make_an_appointment"
                    android:layout_marginBottom="20dp"
                    android:layout_marginTop="10dp"
                    android:layout_gravity="center_horizontal"
                    android:padding="15dp"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:background="@drawable/round_button"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</FrameLayout>
